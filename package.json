{
  "name": "mydashboard",
  "version": "1.0.0",
  "description": "个人全能工作台 - 集计划管理、定时任务、学习记录、习惯追踪、个人记账为一体",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "cap:init": "npx cap init MyDashboard com.mydashboard.app --web-dir=dist",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:build:android": "npm run build && npx cap sync android && npx cap open android",
    "cap:build:ios": "npm run build && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "better-sqlite3": "^11.0.0",
    "chart.js": "^4.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "concurrently": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.0"
  }
}
